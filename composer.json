{
  "name": "mohabmamdouh/wallet",
  "description": "Advanced Laravel Wallet System for financial platforms",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Mohab Mamdouh",
      "email": "mohab@example.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/database": "^10.0|^11.0",
    "illuminate/support": "^10.0|^11.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0",
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "MohabMamdouh\\Wallet\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MohabMamdouh\\Wallet\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "MohabMamdouh\\Wallet\\Providers\\WalletServiceProvider"
      ]
    }
  }
}